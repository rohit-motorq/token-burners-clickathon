# Copy to clickhouse_mcp.env and fill in CLICKHOUSE_PASSWORD.
# Config for the official ClickHouse MCP server (mcp-clickhouse), run
# alongside our own sonyliv-concurrency MCP server as a secondary,
# read-only fallback for analysis our tools don't cover. See
# src/agent/INNER_CONTEXT.md for why this is a fallback, not a peer.

CLICKHOUSE_HOST=mg6ws6jmpr.ap-south-1.aws.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true
CLICKHOUSE_DATABASE=rohitdevtesting

# Read-only by default (mcp-clickhouse's own default) — deliberately left
# unset here rather than overridden, since a fallback analysis tool should
# never be able to write. Do not set these to true.
# CLICKHOUSE_ALLOW_WRITE_ACCESS=false
# CLICKHOUSE_ALLOW_DROP=false

CLICKHOUSE_MCP_SERVER_TRANSPORT=sse
CLICKHOUSE_MCP_BIND_HOST=0.0.0.0
CLICKHOUSE_MCP_BIND_PORT=8812

# SSE/HTTP transport requires explicit auth config. This server only binds
# to localhost/the local network for LibreChat to reach (same trust
# boundary as our own MCP server, which also has no auth) — not
# internet-facing, so disabling MCP-layer auth here is appropriate.
# ClickHouse's own read-only enforcement (above) is the real safety boundary.
CLICKHOUSE_MCP_AUTH_DISABLED=true
