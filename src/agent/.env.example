# Copy to .env and fill in. .env is gitignored — never commit real values.

CH_URL=https://mg6ws6jmpr.ap-south-1.aws.clickhouse.cloud:8443
CH_USER=default
CH_PASS=
# rohitdevtesting runs the migrationv2 pipeline (src/migrationv2/migrations) —
# the authoritative schema, see src/agent/INNER_CONTEXT.md.
CH_DATABASE=rohitdevtesting

ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5

# Base URL a BROWSER can reach this server at, for chart image links in
# replies (fetched client-side, not proxied through LibreChat's container —
# see INNER_CONTEXT.md's "why chart images are served over HTTP" entry).
AGENT_PUBLIC_BASE_URL=http://localhost:8000

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
