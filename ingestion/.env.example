# Copy to .env and fill in. .env is gitignored — never commit real tokens.

# StreamNative Kafka-protocol bootstrap server (host:9093)
STREAMNATIVE_BROKER=pc-xxxxxxxx.aws-use2-production-snci-pool-kid.streamnative.aws.snio.cloud:9093

# StreamNative API key / JWT (without the "token:" prefix)
STREAMNATIVE_TOKEN=eyJhbGciOi...

# Fully qualified topic: <tenant>.<namespace>.<topic>
KAFKA_TOPIC=public.default.events-raw

# Path to the CSV to ingest (absolute, or relative to this package)
CSV_PATH=../Base/SonyLiv/data/ch-hackathon-raw-data.csv

# Optional: column whose value becomes the Kafka message key (keeps a
# session/user on one partition so its events stay ordered)
KEY_FIELD=video_session_id

# Optional tuning
CLIENT_ID=csv-ingestion
BATCH_SIZE=5000
