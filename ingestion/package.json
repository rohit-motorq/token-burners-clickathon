{
  "name": "csv-streamnative-ingestion",
  "version": "1.0.0",
  "private": true,
  "description": "Streams any CSV file into a StreamNative (Kafka protocol) topic",
  "type": "commonjs",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "ingest": "node src/index.js",
    "dry-run": "node src/index.js --dry-run --limit 5"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "^1.6.0",
    "csv-parse": "^5.6.0"
  }
}
